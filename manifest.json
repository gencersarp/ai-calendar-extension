{
  "manifest_version": 3,
  "name": "AI Event Adder for Calendar",
  "version": "1.0",
  "description": "Extract event details from text using AI and add to Google Calendar.",
  "permissions": [
    "identity",    
    "identity.email",
    "storage"       
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID_HERE", 
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events", 
      "https://www.googleapis.com/auth/userinfo.email"   
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}




